# 将需要的配置合并到 backend/.env，或设置为系统环境变量。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=knowledge_base

# 登录后 6 小时内刷新页面、关闭再打开浏览器无需重复登录。
AUTH_SESSION_HOURS=6
# 本地 HTTP 开发使用 false；使用 HTTPS 部署后设置为 true。
AUTH_COOKIE_SECURE=false
# 所有浏览器访问地址必须明确列出，不允许 *。请统一使用 127.0.0.1 或 localhost。
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000,http://127.0.0.1:8001,http://127.0.0.1:8002,http://localhost:5173,http://localhost:8000,http://localhost:8001,http://localhost:8002
